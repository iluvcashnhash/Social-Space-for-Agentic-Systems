# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
CATHEDRAL_LLM_MODEL=gpt-4o-mini        # or gpt-4o, claude-3-5-sonnet, etc.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev / smoke tests):
DATABASE_URL=sqlite:///cathedral_sim.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cathedral

# ── Simulation defaults (override CLI flags) ──────────────────────────────────
CATHEDRAL_MAX_TICKS=24
CATHEDRAL_N_AGENTS=50
CATHEDRAL_SEED=42
